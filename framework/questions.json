      "id": "market", "phase": "discovery",
      "title": "Market & Business",
      "subtitle": "Ground your AI product in real business context",
      "questions": [
        {"id": "q1", "theme": "Business Value Map", "topic": "Industry", "q": "What industry is your business in?", "tip": "e.g., Financial Services, Healthcare, EdTech, Media & Entertainment, SaaS"},
        {"id": "q2", "theme": "Business Value Map", "topic": "Headwinds & Tailwinds", "q": "What are the key headwinds and tailwinds in your industry? Who are the key competitors?", "tip": "List 2-3 headwinds and tailwinds. Name direct and indirect competitors separately."},
        {"id": "q3", "theme": "Business Value Map", "topic": "Market Growth", "q": "What is the projected growth rate of your target market over the next 3-5 years?", "tip": "Cite sources. Use CAGR if available. Include TAM if known."},
        {"id": "q4", "theme": "Business Value Map", "topic": "Growth Stage", "q": "What growth stage is your business in? (Startup, Scale-up, Mature)", "tip": "Consider: revenue trajectory, team size, market position, funding stage."},
        {"id": "q5", "theme": "Business Value Map", "topic": "Revenue Model", "q": "How does your business make money? What is your primary revenue model?", "tip": "Options: Subscription, Freemium, Licensing, Marketplace, Transactional, Project-based, Consultancy."},
        {"id": "q6", "theme": "Business Value Map", "topic": "Customer Base", "q": "Who is your primary customer base? (B2B, B2C, B2B2C)", "tip": "List buyer types, functions you serve, and typical deal size."},
        {"id": "q7", "theme": "Business Value Map", "topic": "Differentiators", "q": "What are the key differentiators for your company?", "tip": "Think: speed, cost, expertise, technology, network effects, proprietary data, agility."}
      ]
