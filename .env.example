# AI PM EXCALIBUR — environment (all optional)
#
# This app authenticates via your Claude Max subscription (claude auth login /
# claude setup-token). It never uses an Anthropic API key — ANTHROPIC_API_KEY is
# stripped at startup on purpose.

# Port for the web server (default 4500)
# PORT=4500

# Override where project JSON files are stored (default ./projects)
# PROJECTS_DIR=/absolute/path/to/projects
